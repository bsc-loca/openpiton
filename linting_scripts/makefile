# Get the directory of linting_scripts
LINT_SCRIPT_DIR := $(CURDIR)
export LINT_SCRIPT_DIR

# path of design flist
FLIST ?= ../build/flist

# path of reporting folder
REPORT_DIR = $(LINT_SCRIPT_DIR)/report
export REPORT_DIR

# path of folder where all verilog files will be copied
UNCORE_MERGED_DIR = $(LINT_SCRIPT_DIR)/uncore
export UNCORE_MERGED_DIR

# Clean targets
VC_CLEAN_FILES = $(REPORT_DIR) $(UNCORE_MERGED_DIR) $(LINT_SCRIPT_DIR)/exclude_nonuncore_autogenerated.awl

$(REPORT_DIR):
	@mkdir -p $(REPORT_DIR)

# Define the Python script
PYTHON_SCRIPT = gen_files.py

#only running python script for test
PY:
	@python3 $(PYTHON_SCRIPT) $(FLIST) $(UNCORE_MERGED_DIR) $(LINT_SCRIPT_DIR)

# Run Python script before executing TCL script, output files in report/
$(REPORT_DIR)/vc_static.txt: clean $(REPORT_DIR) $(PYTHON_SCRIPT) lint_intel_grade.tcl
	@echo "Running Python script to generate filelist..."
	@python3 $(PYTHON_SCRIPT) $(FLIST) $(UNCORE_MERGED_DIR) $(LINT_SCRIPT_DIR) # Run Python script with flist as argument
	@echo " VC          Linting check starts"
	@cd $(REPORT_DIR) && vc_static_shell -batch -f $(LINT_SCRIPT_DIR)/lint_intel_grade.tcl -lic_wait 10 | tee vc_static.txt


# VC target independent
VC_IND: $(REPORT_DIR)/vc_static.txt
	@echo -e "\n \n \e[44m ** LINTING WARNINGS PRIOR TO OPTIMIZATIONS ** \e[0m\n \n "
	@grep "Warning\-" -A 3 $(REPORT_DIR)/vc_static.txt
	@echo -e "\n \n \e[44m ** LINTING ERRORS PRIOR TO OPTIMIZATIONS ** \e[0m\n \n "
	@grep "Error\-" -A 3 $(REPORT_DIR)/vc_static.txt
	@echo -e "\nRunning Python lint checker...\n"
	@python3 lint_checker.py $(REPORT_DIR)/vc_static.txt

# VC target relative to a reference linting report
VC_REL: $(REPORT_DIR)/vc_static.txt
	@python3 lint_compare.py $(LINT_SCRIPT_DIR)/linting_report_ref.txt $(REPORT_DIR)/linting_report.txt $(REPORT_DIR)/linting_report_relative.txt

# Clean VC files
clean:
	@if [ -n "$(wildcard $(VC_CLEAN_FILES))" ]; then \
		printf " RM          VC  %s\n" $(VC_CLEAN_FILES); \
		rm -rf $(VC_CLEAN_FILES); \
	fi

