reg [2:0] hdr_en;
reg [6:0] data_en;

wire   header_buf_empty = (header_buf_counter_f == 0);
wire   header_buf_can_get_1 = !(header_buf_counter_f ==  `L2_P2_HEADER_BUF_IN_SIZE);
wire   header_buf_can_get_3 = (header_buf_counter_f <  `L2_P2_HEADER_BUF_IN_SIZE-2);

wire   data_buf_can_get_1 = !(data_buf_counter_f ==  `L2_P2_DATA_BUF_IN_SIZE);
wire   data_buf_can_get_2 = (data_buf_counter_f <  `L2_P2_DATA_BUF_IN_SIZE-1);
wire   data_buf_can_get_3 = (data_buf_counter_f <  `L2_P2_DATA_BUF_IN_SIZE-2);
wire   data_buf_can_get_4 = (data_buf_counter_f <  `L2_P2_DATA_BUF_IN_SIZE-3);
