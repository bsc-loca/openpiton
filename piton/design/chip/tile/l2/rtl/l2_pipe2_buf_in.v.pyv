wire   data_buf_can_get_6 = (data_buf_counter_f <  `L2_P2_DATA_BUF_IN_SIZE-5);
wire   data_buf_can_get_7 = (data_buf_counter_f <  `L2_P2_DATA_BUF_IN_SIZE-6);

wire   [`L2_P2_HEADER_BUF_IN_LOG_SIZE:0] msg_header_flits =  (header_buf_mem_f[header_rd_ptr_f][`MSG_TYPE] == `MSG_TYPE_WB_REQ) ? 3 : 1;
  

reg [`L2_P2_DATA_BUF_IN_LOG_SIZE:0] data_wr_incr;

always @(*)begin 
	//default 
    ns_in = ps_in;
    hdr_en =3'b000;
    data_en=7'h0;    
    hdr_flit [0] = data_in[63 : 0];
    hdr_flit [1] = data_in[127 : 64];
    hdr_flit [2] = data_in[191 : 128];
    //deafult data location in first flit
    dat_flit [0] = data_in[2*64-1 : 1*64];
    dat_flit [1] = data_in[3*64-1 : 2*64];
    dat_flit [2] = data_in[4*64-1 : 3*64];
