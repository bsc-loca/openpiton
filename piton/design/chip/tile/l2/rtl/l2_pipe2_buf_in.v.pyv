    $display ("\tmsg_header_out= %h %m",msg_header_out);
    if( msg_data_valid_out && msg_data_ready_out) begin
        $display ("\tmsg_data_out=%h",msg_data_out);
        if(msg_data_out=='d0)begin 
        // $stop;
        end
    end
end
