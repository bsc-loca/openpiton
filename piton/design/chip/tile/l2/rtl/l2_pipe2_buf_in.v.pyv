reg [`L2_P2_HEADER_BUF_IN_LOG_SIZE-1:0] header_wr_ptr_f;
reg [`L2_P2_HEADER_BUF_IN_LOG_SIZE-1:0] header_wr_ptr_next;

	

reg [`MSG_LENGTH_WIDTH-1 : 0 ] remained_data_next,	remained_data_f;
wire [`L2_P2_DATA_BUF_IN_LOG_SIZE-1:0] data_wr_ptr_plus1 = data_wr_ptr_f + 1;
wire [`L2_P2_DATA_BUF_IN_LOG_SIZE-1:0] data_wr_ptr_plus2 = data_wr_ptr_f + 2;
wire [`L2_P2_DATA_BUF_IN_LOG_SIZE-1:0] data_wr_ptr_plus3 = data_wr_ptr_f + 3;
wire [`L2_P2_DATA_BUF_IN_LOG_SIZE-1:0] data_wr_ptr_plus4 = data_wr_ptr_f + 4;
wire [`L2_P2_DATA_BUF_IN_LOG_SIZE-1:0] data_wr_ptr_plus5 = data_wr_ptr_f + 5;
wire [`L2_P2_DATA_BUF_IN_LOG_SIZE-1:0] data_wr_ptr_plus6 = data_wr_ptr_f + 6;
wire [`L2_P2_DATA_BUF_IN_LOG_SIZE-1:0] data_wr_ptr_plus7 = data_wr_ptr_f + 7;


