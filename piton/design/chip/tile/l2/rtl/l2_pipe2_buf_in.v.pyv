		IDEAL: begin 
			if(data_in[`MSG_TYPE] != `MSG_TYPE_WB_REQ)begin //we have single 64-bit header flit
    			if(data_in[`MSG_LENGTH] == `MSG_LENGTH_WIDTH'd0) begin
					if(header_buf_can_get_1) begin 
                        hdr_en[0]=1'b1;
                        ready_in=1'b1;
                    end //not full
				end else if(data_in[`MSG_LENGTH] == `MSG_LENGTH_WIDTH'd1)begin 
					// When receive 1 data flit, we store the same data flit in two slots in the buffer.
					// This is because we always read out 2 flits of data.					
                    if(header_buf_can_get_1 & data_buf_can_get_2)begin
                        hdr_en[0]=1'b1;                        
                        data_en[1:0]=2'b11;  						
                        ready_in=1'b1;	
                        data_wr_incr=2;			
                    end//not full
    ''')
    for i in range(2,8):
        print('''               end else if(data_in[`MSG_LENGTH] == `MSG_LENGTH_WIDTH'd%d) begin 			                   
                    if(header_buf_can_get_1 & data_buf_can_get_%d)begin
                        hdr_en[0]=1'b1;                       
                        data_en[%d:0]=%d;                
