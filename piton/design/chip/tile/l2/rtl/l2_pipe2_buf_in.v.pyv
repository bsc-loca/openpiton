    ''')

    for i in range(L2_P2_HEADER_BUF_IN_SIZE):
        print("        header_buf_mem_f[%d] <= 0;" % (i))
    for i in range(L2_P2_DATA_BUF_IN_SIZE):
        print("        data_buf_mem_f[%d] <= 0;" % (i))

