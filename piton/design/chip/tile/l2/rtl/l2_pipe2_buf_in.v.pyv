       if (data_en [7]) data_buf_mem_f[data_wr_ptr_plus7] <= dat_flit [7];      
    end
   
end

    ''')   






if (NOC3_WIDTH == 704) :
    print('''


reg [`NOC_DATA_WIDTH-1:0] data_buf_mem_f [`L2_P2_DATA_BUF_IN_SIZE-1:0];


reg [`L2_P2_DATA_BUF_IN_LOG_SIZE:0] data_buf_counter_f;
