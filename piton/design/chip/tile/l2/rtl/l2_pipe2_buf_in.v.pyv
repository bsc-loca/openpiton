wire [`L2_P2_HEADER_BUF_IN_LOG_SIZE-1:0]  header_wr_ptr_plus2 = header_wr_ptr_f + 2;
wire [`L2_P2_DATA_BUF_IN_LOG_SIZE-1:0] data_rd_ptr_plus1 = data_rd_ptr_f + 1;	
wire [`L2_P2_HEADER_BUF_IN_LOG_SIZE-1:0] header_rd_ptr_plus1 =header_rd_ptr_f +1;
wire [`L2_P2_HEADER_BUF_IN_LOG_SIZE-1:0] header_rd_ptr_plus2 =header_rd_ptr_f +2;

